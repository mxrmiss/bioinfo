# -*- coding: utf-8 -*-
# =============================================================
# Snakefile —— 工具优先 · 零猜测 · 哨兵式依赖 · 屏幕+日志双写
# =============================================================

import os
configfile: "config.yaml"

P = config["paths"]
BIN = config.get("binaries", {})
LOG_DIR = "logs"
SCRIPTS = "scripts"

# 哨兵与关键文件
PROT_DONE   = os.path.join("data/proteomes", ".from_gff.done")
HEADERS_DONE = os.path.join("data/proteomes", ".headers_norm.done") 
OF_DONE     = os.path.join(P["orthofinder_results_dir"], ".OF_DONE")
SCO_LIST    = os.path.join(P["reports_dir"], "ogs_selected.list")
SCO_DONE    = os.path.join(P["reports_dir"], ".ogs_selected.done")
TRIM_DONE   = os.path.join(P["msa_trim_dir"], ".done")
NORM_DONE   = os.path.join(P["normalize_dir"], ".norm.done")
COLL_DONE   = os.path.join(P["collapse_dir"], ".done")
SPC_DONE    = os.path.join(P["species_collapse_dir"], ".done")
SCOLIST     = os.path.join(P["reports_dir"], "sco_filelist.txt")
SCOL_DONE   = os.path.join(P["reports_dir"], ".sco_filelist.done")
SUPER_FASTA = os.path.join(P["supermatrix_dir"], "supermatrix.faa")
SUPER_DONE  = os.path.join(P["supermatrix_dir"], ".supermatrix.done")
TREE_NWK    = os.path.join(P["trees_dir"], "species_tree.nwk")
IQ_DONE     = os.path.join(P["trees_dir"], ".iqtree.done")
MATRIX_TSV  = os.path.join(P["reports_dir"], "matrix.tsv")
MATRIX_DONE = os.path.join(P["reports_dir"], ".matrix.done")
PUB_DONE    = os.path.join(P["publish_dir"], ".publish.done")

rule all:
    input:
        PUB_DONE,
        MATRIX_DONE,
        IQ_DONE,
        SUPER_DONE

# 若想重跑此步，需要删除/data/proteomes/下的隐藏文件夹.from_gff.done
rule build_proteomes_from_gff:
    output: sentinel=PROT_DONE
    log: f"{LOG_DIR}/build_proteomes_from_gff.log"
    params:
        py = BIN.get("python","python"),
        proteome_dir = config["input"]["proteome_dir"],
        cds_dir = config["input"]["cds_dir"],
        script = f"{SCRIPTS}/extract_longest_from_gff.py"
    shell:
        r'''set -euo pipefail
        mkdir -p "$(dirname {log})" "{params.proteome_dir}" "{params.cds_dir}"
        {params.py} {params.script} 2>&1 | tee -a {log}
        touch {output.sentinel}
        '''

rule rename_proteome_headers:
    # 将 data/proteomes/*.fa* 表头统一为 `Species|SeqID`（仅改头，不改序列）
    input: PROT_DONE
    output: sentinel=HEADERS_DONE
    log: f"{LOG_DIR}/rename_proteome_headers.log"
    params:
        py = BIN.get("python","python"),
        script = f"{SCRIPTS}/rename_proteome_headers.py"
    shell:
        r'''set -euo pipefail
        mkdir -p "$(dirname {log})"
        {params.py} {params.script} 2>&1 | tee -a {log}
        touch {output.sentinel}
        '''

